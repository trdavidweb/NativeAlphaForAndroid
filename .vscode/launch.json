{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build Full Release",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash \"${workspaceFolder}/scripts/android-vscode.sh\" full; exit $?",
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": false
    },
    {
      "name": "Build Release",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash \"${workspaceFolder}/scripts/android-vscode.sh\" release; exit $?",
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": false
    },
    {
      "name": "Install on Android",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash \"${workspaceFolder}/scripts/android-vscode.sh\" install; exit $?",
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": false
    }
  ]
}
