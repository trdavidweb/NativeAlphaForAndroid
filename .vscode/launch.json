{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build Full Release",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/scripts/vscode-launch.sh",
      "program": "${workspaceFolder}/scripts/vscode-launch.mjs",
      "args": [
        "full"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": false
    },
    {
      "name": "Build Release",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/scripts/vscode-launch.sh",
      "program": "${workspaceFolder}/scripts/vscode-launch.mjs",
      "args": [
        "release"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": false
    },
    {
      "name": "Install on Android",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/scripts/vscode-launch.sh",
      "program": "${workspaceFolder}/scripts/vscode-launch.mjs",
      "args": [
        "install"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": false
    }
  ]
}
